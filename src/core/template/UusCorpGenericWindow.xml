<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../Interface.xsd">
    <Windows>
        <Window name="UusCorpGenericWindow" movable="true" handleinput="true" popable="true">
            <Size>
                <AbsPoint x="100" y="100" />
            </Size>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="UusCorpWindowLifeCycle.onInitialize"/>
            </EventHandlers>
            <Windows>
                <FullResizeImage name="$parentBackground" inherits="UO_Simple_Black_Background" layer="background">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft"/>
                        <Anchor point="bottomright" relativePoint="bottomright"/>
                    </Anchors>
                </FullResizeImage>
                <FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame" >
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" />
                        <Anchor point="bottomright" relativePoint="bottomright" />
                    </Anchors>
                </FullResizeImage>
            </Windows>
        </Window>

        <Window name="UusCorpGenericLabel">
            <Size>
                <AbsPoint x="20" y="20" />
            </Size>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="UusCorpWindowLifeCycle.onInitialize"/>
            </EventHandlers>
            <Windows>
                <Label name="$parentView" font="inter_medium_18" autoresize="true">
                    <Size>
                        <AbsPoint x="0" y="0" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" />
                        <Anchor point="bottomright" relativePoint="bottomright" />
                    </Anchors>
                </Label>
            </Windows>
        </Window>

        <Window name="UusCorpGenericButton">
            <Size>
                <AbsPoint x="20" y="20" />
            </Size>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="UusCorpWindowLifeCycle.onInitialize"/>
            </EventHandlers>
            <Windows>
                <Button name="$parentView" font="inter_medium_18" autoresize="true">
                    <Size>
                        <AbsPoint x="0" y="0" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" />
                        <Anchor point="bottomright" relativePoint="bottomright" />
                    </Anchors>
                </Button>
            </Windows>
        </Window>
    </Windows>
</Interface>