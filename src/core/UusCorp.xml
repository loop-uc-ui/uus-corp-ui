<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Windows>
        <Button name="UusCorpButton" font="inter_medium_20"/>

        <Window name="UusCorpWindow" movable="true" layer="popup">
            <EventHandlers>
                <EventHandler event="OnInitialize" function="UusCorp.EventHandler.onInitialize"/>
            </EventHandlers>
            <Anchors>
                <Anchor point="center" relativePoint="center" relativeTo="Root">
                    <AbsPoint x="0" y="0"/>
                </Anchor>
            </Anchors>
            <Windows>
                <!-- Body background -->
                <FullResizeImage name="$parentWindowBackground" inherits="UO_Simple_Black_Background">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft"/>
                        <Anchor point="bottomright" relativePoint="bottomright"/>
                    </Anchors>
                </FullResizeImage>

                <!-- Inner Frame Boilerplate -->
                <FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame" >
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" />
                        <Anchor point="bottomright" relativePoint="bottomright" />
                    </Anchors>
                </FullResizeImage>
                <!-- End of Inner Frame Boilerplate -->
            </Windows>
        </Window>

    </Windows>
</Interface>